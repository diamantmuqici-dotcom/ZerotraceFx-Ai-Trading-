# ============================================================
# ZeroTrace FX AI - Configuration (copy to .env and edit)
# ============================================================

# --- Account / mode ------------------------------------------
ACCOUNT_MODE=PAPER            # PAPER | LIVE | BACKTEST
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                     # optional path to terminal64.exe
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
MAGIC_NUMBER=240901

# --- AI / strategy -------------------------------------------
CONFIDENCE_THRESHOLD=85
ATR_PERIOD=14
ATR_SL_MULT=1.5
MIN_RR=2.0
SWING_LEFT=3
SWING_RIGHT=3
STRUCTURE_LOOKBACK=50
STRUCTURE_RECENCY_BARS=30
FVG_MIN_SIZE_ATR=0.05
EQ_TOLERANCE_ATR=0.25
OB_LOOKBACK=120
OB_DISPLACEMENT_MULT=1.0
SWEEP_RECENCY_BARS=30
FVG_PROXIMITY_ATR=1.5

# --- Risk ----------------------------------------------------
RISK_PERCENT=1.0
MAX_POSITIONS=8
MAX_TOTAL_LOTS=5.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_DRAWDOWN_PCT=10.0
MAX_CONSECUTIVE_LOSSES=4
SPREAD_LIMIT_PIPS=3.0
SLIPPAGE_MAX_PIPS=2.0
LATENCY_MAX_MS=800
BREAK_EVEN_TRIGGER_RR=1.0
BREAK_EVEN_OFFSET_PIPS=2.0
TRAILING_START_RR=1.5
TRAILING_STEP_PIPS=10.0
PARTIAL_TP_ENABLED=true
PARTIAL_TP_RR=1.5
PARTIAL_TP_PCT=50.0

# --- Basket --------------------------------------------------
BASKET_TARGET=100.0
BASKET_TRAILING_ENABLED=false
BASKET_TRAILING_PCT=15.0

# --- News / sessions -----------------------------------------
NEWS_FILTER_ENABLED=true
NEWS_BEFORE_MIN=30
NEWS_AFTER_MIN=30
NEWS_MIN_IMPACT=HIGH          # LOW | MEDIUM | HIGH
NEWS_CSV=
SESSION_FILTER_ENABLED=false
ALLOWED_SESSIONS=London,NewYork

# --- Trading costs (paper/backtest) --------------------------
COMMISSION_PER_LOT=7.0
SLIPPAGE_PIPS=0.5
PAPER_BALANCE=10000.0
LEVERAGE=100

# --- Runtime -------------------------------------------------
POLL_INTERVAL_SEC=5
CANDLES_COUNT=500
MAX_RETRIES=3
LOG_LEVEL=INFO
DATA_DIR=data
LOGS_DIR=logs
REPORTS_DIR=reports

# --- Adaptive learning (AI improves from every closed trade) ---
LEARNING_ENABLED=true
LEARNING_RATE=0.05
# Stored inside LOGS_DIR; delete it to reset what the AI has learned
LEARNING_MEMORY_FILE=ai_memory.json
LEARNING_MIN_TRADES=5

# --- Remote API for the Android companion app (off by default) ---
# Requires a long random token (16+ chars). Only expose on a trusted network/VPN.
REMOTE_API_ENABLED=false
REMOTE_API_HOST=0.0.0.0
REMOTE_API_PORT=8765
REMOTE_API_TOKEN=
